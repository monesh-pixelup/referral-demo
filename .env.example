# --- Needed in production now ---
# Signs the session cookie. 32+ random characters (e.g. `openssl rand -base64 48`). Required when NODE_ENV=production.
SESSION_SECRET=
# Demo sign-in (pick any account, no password). Always on in `npm run dev`; in production only when "on".
# Turn OFF before real partners use the app; Supabase magic links replace it.
DEMO_LOGIN=off

# --- Supabase (next milestone; the app runs on in-memory demo data until then) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- App ---
# Comma-separated; these become admins on first login once Supabase auth is wired.
ADMIN_EMAILS=monesh@pixelup.in
# Placeholder: set the real domain before go-live.
APP_URL=http://localhost:3000
